generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../src/backend/database/monitor.db"
}

// 1. Metadatos semánticos del sensor (envuelven la respuesta RPC del Firmware)
model sensor {
  hexadecimal           String      @id
  id_sensor             Int         @unique
  ubicacion             String?
  ubicacion_descripcion String?
  nombre                String?
  descripcion           String?
  activa                Int         @default(1)
  fecha_creacion        String      @default("CURRENT_TIMESTAMP")
  fecha_modificacion    String      @default("CURRENT_TIMESTAMP")
  auditorias            auditoria[]
}

// 2. Auditoría local de quién cambió el nombre o movió de lugar un sensor
model auditoria {
  id_auditoria   Int    @id @default(autoincrement())
  id_sensor      Int
  accion         String
  usuario        String
  nombre         String?
  apellido       String?
  activo         Int    @default(1)
  fecha_creacion String @default("CURRENT_TIMESTAMP")

  sensor         sensor @relation(fields: [id_sensor], references: [id_sensor], onDelete: NoAction, onUpdate: Cascade)

  @@index([id_sensor], map: "idx_auditoria_sensor")
}

// 3. Helper de conexión para recordar la IP DHCP y puerto del ESP
model conexion_firmware {
  id_conexion        Int    @id @default(1)
  ip_dhcp            String @default("192.168.4.1")
  puerto_udp         Int    @default(80)
  puerto_usb         String @default("/tmp/virtual_serial")
  baudios_usb        Int    @default(115200)
  fecha_modificacion String @default("CURRENT_TIMESTAMP")
}