// =========================================================
// Heladera Lab UNTDF - BASE DE DATOS ÚNICA EN microSD (SQLite)
// Pegar en https://dbdiagram.io
// =========================================================
// Todo vive en la microSD. Dos grupos bien separados:
//
//   A_SISTEMA    = lo que QUERÉS guardar (el producto):
//                  sensores, sensos, eventos, correos, SMTP, red,
//                  calibración, NTP, auditoría.
//   B_SEGURIDAD  = lo que ESTÁS OBLIGADO a guardar para que el equipo
//                  pueda autenticar, autorizar y protegerse:
//                  usuarios, claves públicas, sesiones, permisos,
//                  política, certificados, claves del sistema,
//                  bloqueos, aprovisionamiento y estado del reloj.
//   C_INFRA      = metadatos de la base (versión del esquema).
//
// Convenciones:
//   - Fechas: epoch UTC en segundos (bigint).
//   - fuente_tiempo + boot_id: dicen si la fecha es confiable.
//   - Baja lógica (activa = 0) en vez de DELETE en datos con historia.
//   - Columnas *_cifrado: AES-256-GCM con la clave vigente de
//     ClaveSistema (CLAVE_CIFRADO_COLUMNAS). Evita que los secretos
//     salgan en claro en copias, exportaciones o respuestas del API.
//     NO protege contra quien tenga la tarjeta física (riesgo aceptado).
// =========================================================

Project heladera {
  database_type: 'SQLite'
  Note: 'Base única en microSD. Grupos: A_SISTEMA, B_SEGURIDAD, C_INFRA.'
}

// ----------------- ENUMS -----------------
Enum CriticidadEvento {
  CRITICIDAD_BAJA
  CRITICIDAD_MEDIA
  CRITICIDAD_CRITICA
}

Enum TipoRecepcionCorreo {
  RECIBIR_TODOS
  RECIBIR_EVENTOS
  RECIBIR_EVENTOS_CRITICOS
}

Enum EstadoEnvioCorreo {
  ENVIO_PENDIENTE
  ENVIO_ENVIADO
  ENVIO_FALLIDO
}

Enum MedioConexion {
  MEDIO_INTERNO
  MEDIO_USB
  MEDIO_WIFI_STA
  MEDIO_WIFI_AP
}

Enum ResultadoAuditoria {
  RESULTADO_EXITO
  RESULTADO_DENEGADO_ROL
  RESULTADO_CREDENCIAL_INVALIDA
  RESULTADO_CLAVE_REVOCADA
  RESULTADO_SESION_EXPIRADA
  RESULTADO_LIMITE_TASA
  RESULTADO_INTRUSION_TERMINAL
  RESULTADO_ERROR_VALIDACION
}

Enum RolSGBD {
  ROL_NINGUNO
  ROL_NO_ADMIN
  ROL_ADMIN
}

Enum Recurso {
  RECURSO_SENSORES
  RECURSO_SENSOS
  RECURSO_EVENTOS
  RECURSO_CORREOS
  RECURSO_SMTP
  RECURSO_RED
  RECURSO_CALIBRACION
  RECURSO_NTP
  RECURSO_AUDITORIA
  RECURSO_USUARIOS
  RECURSO_CLAVES
  RECURSO_CERTIFICADOS
  RECURSO_POLITICA
  RECURSO_SISTEMA
}

Enum AccionPermiso {
  ACCION_VER
  ACCION_CREAR
  ACCION_MODIFICAR
  ACCION_ELIMINAR
}

Enum EstadoClave {
  CLAVE_PENDIENTE
  CLAVE_ACTIVA
  CLAVE_REVOCADA
}

Enum ClaveProposito {
  CLAVE_CIFRADO_COLUMNAS
  CLAVE_MAC_AUDITORIA
  CLAVE_MAC_TOKENS
}

Enum EstadoClaveSistema {
  CLAVESIS_ACTIVA
  CLAVESIS_RETIRADA
}

Enum TipoCertificado {
  CERT_SERVIDOR
  CERT_CA
}

Enum EstadoCertificado {
  CERT_ACTIVO
  CERT_SIGUIENTE
  CERT_RETIRADO
}

Enum EstadoAprovisionamiento {
  APROV_VIRGEN
  APROV_SETUP_EN_CURSO
  APROV_LISTO
}

Enum FuenteTiempo {
  TIEMPO_SIN_SINCRONIZAR
  TIEMPO_NTP
  TIEMPO_CLIENTE
}

Enum EstadoSensor {
  OK
  ALARMA_SUPERIOR
  ALARMA_INFERIOR
  SLOT_VACIO
  DIRECCION_ROM_INVALIDA
  FAMILIA_NO_COMPATIBLE
  SCRATCHPAD_VACIO_CEROS
  ERROR_CRC_SCRATCHPAD
  CONVERSION_PENDIENTE
  TIMEOUT_CONVERSION
  FALLO_ESCRITURA_EEPROM
  DESCONECTADO
  ALIMENTACION_INSUFICIENTE
  REINICIO_ENERGIA_85C
  CORTOCIRCUITO_VDD
  CORTOCIRCUITO_GND
  CIRCUITO_ABIERTO
}

Enum EstadoBus {
  OK
  LINEA_EN_CORTO_GND
  SIN_PULSO_PRESENCIA
  TOPOLOGIA_MODIFICADA
  FALLO_CONVERSION_GLOBAL
  LIMITE_SENSORES_EXCEDIDO
}

Enum EventoGestor {
  NINGUNO
  BUS_INICIALIZADO
  NUEVO_SENSOR_DETECTADO
  SENSOR_DESCONECTADO_EN_CALIENTE
  CONVERSION_COMPLETADA
  ERROR_BUS_ELECTRICO
  ALARMA_DETECTADA_EN_BUS
  TIEMPO_SINCRONIZADO
  TIEMPO_AJUSTADO_POR_CLIENTE
}

// =========================================================
// GRUPO A: LO QUE QUERÉS GUARDAR (el sistema)
// =========================================================

// A1. Catálogo de sensores y su configuración
Table Sensor {
  id_sensor                   int           [pk, increment]
  hexadecimal                 varchar(16)   [unique, not null, note: 'ROM 64 bits. CHECK longitud = 16']
  hexadecimal2                varchar(2)    [not null, note: 'Código de familia (caché para el wrapper). CHECK: coincide con el byte de familia dentro de hexadecimal']
  nombre                      varchar(32)   [not null, default: 'Sensor Nuevo']
  descripcion                 varchar(64)   [default: '']
  ubicacion                   varchar(32)   [not null, default: 'Sin asignar']
  ubicacion_descripcion       varchar(64)   [default: '']
  offset_calibracion          float         [not null, default: 0.0]
  correccion_superior         float         [not null, default: 0.0]
  correccion_inferior         float         [not null, default: 0.0]
  umbral_superior             float         [not null, default: 125.0, note: 'CHECK entre -55 y 125. Se escribe en la EEPROM del sensor']
  umbral_inferior             float         [not null, default: -55.0, note: 'CHECK entre -55 y 125. Se escribe en la EEPROM del sensor']
  resolucion_bits             int           [not null, default: 12, note: 'CHECK 9 a 12']
  alimentacion_parasita       int           [not null, default: 0]
  pendiente_escritura_eeprom  int           [not null, default: 0, note: '1 = cambios aún no escritos en el sensor; al reconectarlo se reescriben solos']
  estado_actual               EstadoSensor  [default: 'OK']
  activa                      int           [default: 1, note: 'Baja lógica. No borrar: protege el histórico']
  fecha_creacion              bigint
  fecha_modificacion          bigint
}

// A2. Telemetría
Table Senso {
  id_senso              int           [pk, increment]
  id_sensor             int           [not null]
  temperatura_cruda     float         [not null]
  temperatura_corregida float         [not null]
  estado_sensor         EstadoSensor  [default: 'OK']
  boot_id               int           [not null]
  fuente_tiempo         FuenteTiempo  [not null, default: 'TIEMPO_SIN_SINCRONIZAR']
  fecha_creacion        bigint        [not null]

  Indexes {
    (id_sensor, fecha_creacion) [name: 'idx_senso_sensor_fecha']
    fecha_creacion
  }
  Note: 'Alto volumen. Escribir por lotes en una transacción. Rotar según ConfiguracionSistema.retencion_senso_dias.'
}

// A3. Eventos por sensor
Table EventoSensor {
  id_evento_sensor     int                [pk, increment]
  id_sensor            int                [not null]
  id_senso             int                [not null]
  estado_previo_sensor EstadoSensor       [not null]
  estado_nuevo_sensor  EstadoSensor       [not null]
  evento               EventoGestor       [not null, default: 'NINGUNO']
  criticidad           CriticidadEvento   [default: 'CRITICIDAD_MEDIA']
  notificado_smtp      EstadoEnvioCorreo  [default: 'ENVIO_PENDIENTE']
  activa               int                [default: 1]
  fecha_creacion       bigint
  fecha_modificacion   bigint

  Indexes {
    notificado_smtp
    id_sensor
  }
}

// A4. Eventos del sistema
Table EventoSistema {
  id_evento_sistema   int                 [pk, increment]
  estado_bus          EstadoBus           [default: 'OK']
  evento_gestor       EventoGestor        [default: 'NINGUNO']
  criticidad          CriticidadEvento    [default: 'CRITICIDAD_MEDIA']
  espacio_sd_libre_kb int                 [default: 0]
  heap_libre_bytes    int                 [default: 0]
  reset_reason        varchar(24)         [default: '', note: 'Motivo del último reinicio (watchdog, brownout, etc.)']
  version_firmware    varchar(16)         [default: '']
  detalle             varchar(96)         [not null]
  notificado_smtp     EstadoEnvioCorreo   [default: 'ENVIO_PENDIENTE']
  boot_id             int                 [not null]
  uptime_s            int                 [not null]
  fuente_tiempo       FuenteTiempo        [not null, default: 'TIEMPO_SIN_SINCRONIZAR']
  activa              int                 [default: 1]
  fecha_creacion      bigint

  Indexes {
    notificado_smtp
  }
}

// A5. Destinatarios de correo
Table Correos {
  id_correo               int                  [pk, increment]
  nombre                  varchar(24)          [not null]
  apellido                varchar(24)          [default: '']
  correo_electronico      varchar(48)          [unique, not null, note: 'CHECK formato email']
  tipo_recepcion_mensajes TipoRecepcionCorreo  [default: 'RECIBIR_TODOS']
  ultimo_estado_envio     EstadoEnvioCorreo    [default: 'ENVIO_PENDIENTE']
  activa                  int                  [default: 1]
  fecha_creacion          bigint
  fecha_modificacion      bigint
}

// A6. Cola de envíos (opcional, recomendada: permite reintentos por destinatario)
Table CorreoEnvio {
  id_envio             int                [pk, increment]
  id_correo            int                [not null]
  id_evento_sensor     int                [note: 'Uno de los dos, no ambos. CHECK']
  id_evento_sistema    int
  estado               EstadoEnvioCorreo  [not null, default: 'ENVIO_PENDIENTE']
  intentos             int                [not null, default: 0]
  proximo_reintento    bigint             [default: 0, note: 'Backoff exponencial']
  ultimo_error         varchar(64)        [default: '']
  fecha_creacion       bigint
  fecha_envio          bigint

  Indexes {
    (estado, proximo_reintento) [name: 'idx_envio_cola']
  }
}

// A7. Configuración SMTP (singleton)
Table ConfiguracionSmtp {
  id_configuracion_smtp int          [pk, default: 1, note: 'Singleton: CHECK (id = 1)']
  host_smtp             varchar(40)  [not null]
  puerto                int          [not null, default: 465]
  usar_tls              int          [not null, default: 1]
  usuario               varchar(48)  [not null]
  password_cifrado      varchar(160) [not null, note: 'AES-GCM: nonce + texto cifrado + tag, en hex']
  email_remitente       varchar(48)  [not null, note: 'CHECK formato email']
  nombre_remitente      varchar(32)  [default: 'Laboratorio UNTDF']
  activa                int          [default: 1]
  fecha_creacion        bigint
  fecha_modificacion    bigint
}

// A8. Conectividad WiFi (singleton)
Table ConfiguracionConectividad {
  id_configuracion_conectividad int          [pk, default: 1, note: 'Singleton: CHECK (id = 1)']
  ssid_sta                      varchar(33)  [not null]
  sta_password_cifrado          varchar(160) [default: '']
  ssid_ap                       varchar(33)  [not null]
  ap_password_cifrado           varchar(160) [default: '', note: 'Sin valor por defecto: se genera al aprovisionar']
  ap_canal                      int          [default: 6]
  ap_habilitado                 int          [default: 1]
  activa                        int          [default: 1]
  fecha_creacion                bigint
  fecha_modificacion            bigint
}

// A9. Calibración atmosférica (singleton)
Table Calibracion {
  id_calibracion       int      [pk, default: 1, note: 'Singleton: CHECK (id_calibracion = 1)']
  altura               float    [not null, default: 0.0,     note: 'CHECK entre -500 y 9000']
  presion_atmosferica  float    [not null, default: 1013.25, note: 'CHECK entre 300 y 1100']
  temp_congelacion_ref float    [not null, default: 0.0]
  temp_ebullicion_ref  float    [not null, default: 100.0]
  activa               int      [default: 1]
  fecha_creacion       bigint
  fecha_modificacion   bigint
}

// A10. Servidores NTP
Table ServidoresNtp {
  id_server          int          [pk, increment]
  server             varchar(40)  [unique, not null]
  prioridad          int          [not null, default: 1, note: 'Menor número = se prueba primero']
  activa             int          [default: 1]
  fecha_creacion     bigint
  fecha_modificacion bigint
}

// A11. Parámetros operativos (singleton)
Table ConfiguracionSistema {
  id_configuracion_sistema int  [pk, default: 1, note: 'Singleton: CHECK (id = 1)']
  zona_horaria_min         int  [not null, default: -180, note: 'Offset respecto de UTC en minutos']
  retencion_senso_dias     int  [not null, default: 365]
  retencion_eventos_dias   int  [not null, default: 730]
  retencion_auditoria_dias int  [not null, default: 1095]
  sd_libre_minimo_kb       int  [not null, default: 51200, note: 'Bajo este umbral: evento crítico y purga de lo permitido']
  correo_cooldown_s        int  [not null, default: 900, note: 'Antispam: no repetir el mismo evento antes de este tiempo']
  activa                   int  [default: 1]
  fecha_modificacion       bigint
}

// A12. Auditoría (conecta A con B: registra la actividad de seguridad)
Table Auditoria {
  id_auditoria      int                 [pk, increment]
  seq               bigint              [unique, not null, note: 'Contador monótono sin saltos']
  id_usuario        int                 [note: 'Null o 0 si no hay usuario válido']
  usuario_intentado varchar(20)         [default: '', note: 'Lo que se escribió en el login, aunque no exista']
  accion            varchar(32)         [not null]
  tabla_afectada    varchar(32)         [default: 'NINGUNA']
  valor_previo      varchar(64)         [default: '', note: 'NUNCA registrar secretos; enmascarar']
  valor_nuevo       varchar(64)         [default: '', note: 'NUNCA registrar secretos; enmascarar']
  detalle           varchar(120)        [not null]
  medio_conexion    MedioConexion       [default: 'MEDIO_INTERNO']
  origen_remoto     varchar(46)         [default: 'LOCAL', note: '46 = alcanza para IPv6']
  resultado         ResultadoAuditoria  [default: 'RESULTADO_EXITO']
  criticidad        CriticidadEvento    [default: 'CRITICIDAD_BAJA']
  boot_id           int                 [not null]
  uptime_s          int                 [not null]
  fuente_tiempo     FuenteTiempo        [not null, default: 'TIEMPO_SIN_SINCRONIZAR']
  fecha_creacion    bigint
  hash_previo       varchar(64)         [not null, note: 'hash_registro de la fila anterior (la primera usa 64 ceros)']
  hash_registro     varchar(64)         [not null, note: 'HMAC-SHA256(clave CLAVE_MAC_AUDITORIA, hash_previo + campos). Detecta ediciones o borrados']

  Indexes {
    fecha_creacion
  }
  Note: 'Solo INSERT desde la aplicación. Sin columna activa: no se da de baja un registro de auditoría.'
}

// =========================================================
// GRUPO B: LO QUE ESTÁS OBLIGADO A GUARDAR (seguridad)
// =========================================================

// B1. Identidad: quién puede entrar
Table Usuarios {
  id_usuario              int          [pk, increment, note: 'Sembrar id 0 = "anonimo" (ROL_ANONIMO) para eventos sin usuario']
  usuario                 varchar(20)  [unique, not null]
  salt                    varchar(32)  [not null, note: '16 bytes aleatorios en hex']
  contrasena_hash         varchar(64)  [not null, note: 'PBKDF2-HMAC-SHA256, 32 bytes en hex']
  algoritmo_hash          varchar(16)  [not null, default: 'PBKDF2-SHA256']
  iteraciones             int          [not null, default: 100000, note: 'Calibrar en el equipo (objetivo ~0.5 a 1 s)']
  rol                     RolSGBD      [not null, default: 'ROL_LECTOR']
  intentos_fallidos       int          [not null, default: 0]
  bloqueado               int          [not null, default: 0, note: 'Bloqueo manual por un admin']
  bloqueado_hasta         bigint       [default: 0, note: 'Bloqueo temporal por intentos fallidos']
  debe_cambiar_password   int          [not null, default: 1]
  fecha_ultimo_login      bigint
  fecha_cambio_password   bigint
  activa                  int          [default: 1, note: 'Baja lógica. Nunca DELETE físico']
  fecha_creacion          bigint
  fecha_modificacion      bigint
}

// B2. Autenticación asimétrica de las apps cliente (Electron)
Table ClavesPublicas {
  id_clave            int          [pk, increment]
  id_usuario          int          [not null]
  nombre_dispositivo  varchar(32)  [not null, note: 'Ej: "PC-lab-3 de Perez"']
  algoritmo           varchar(16)  [not null, default: 'ECDSA-P256', note: 'o Ed25519']
  clave_publica       varchar(192) [not null, note: 'Hex. La clave privada NUNCA sale de la máquina del usuario']
  fingerprint         varchar(64)  [unique, not null, note: 'SHA-256 de la clave pública']
  estado              EstadoClave  [not null, default: 'CLAVE_PENDIENTE', note: 'Pendiente hasta que un admin la aprueba']
  id_aprobada_por     int
  fecha_alta          bigint
  fecha_expira        bigint       [default: 0, note: '0 = no expira']
  fecha_revocacion    bigint       [default: 0]
}

// B3. Sesiones activas
Table Sesiones {
  id_sesion          int            [pk, increment]
  id_usuario         int            [not null]
  id_clave           int            [note: 'Clave con la que se autenticó (si aplica)']
  token_hash         varchar(64)    [unique, not null, note: 'HMAC-SHA256(CLAVE_MAC_TOKENS, token). El token en claro solo existe en el cliente']
  medio_conexion     MedioConexion  [not null]
  origen_remoto      varchar(46)    [default: 'LOCAL']
  boot_id            int            [not null]
  uptime_creacion_s  int            [not null]
  uptime_expira_s    int            [not null, note: 'La expiración usa uptime, no fecha (por si la hora es de cliente)']
  revocada           int            [not null, default: 0]
  fecha_creacion     bigint
}

// B4. Autorización: qué puede hacer cada rol (denegar por defecto)
Table PermisosRol {
  id_permiso  int            [pk, increment]
  rol         RolSGBD        [not null]
  recurso     Recurso        [not null]
  accion      AccionPermiso  [not null]

  Indexes {
    (rol, recurso, accion) [unique, name: 'uq_permiso']
  }
  Note: 'Sin fila = denegado. Toda operación consulta esta tabla antes de ejecutarse.'
}

// B5. Política de seguridad (singleton)
Table PoliticaSeguridad {
  id_politica              int          [pk, default: 1, note: 'Singleton: CHECK (id = 1)']
  login_max_intentos       int          [not null, default: 5]
  login_bloqueo_s          int          [not null, default: 900]
  sesion_ttl_inactividad_s int          [not null, default: 1800]
  sesion_ttl_absoluto_s    int          [not null, default: 28800]
  max_sesiones             int          [not null, default: 4, note: 'La RAM limita las conexiones TLS simultáneas']
  password_largo_minimo    int          [not null, default: 12]
  password_vigencia_dias   int          [not null, default: 0, note: '0 = no vence']
  desafio_ttl_s            int          [not null, default: 30, note: 'Vida del nonce del desafío firmado']
  limite_solicitudes_min   int          [not null, default: 120, note: 'Por origen']
  hora_cliente_permitida   int          [not null, default: 1, note: 'Aceptar hora de un cliente si no hay NTP']
  tls_version_minima       varchar(8)   [not null, default: 'TLS1.2']
  fecha_modificacion       bigint
}

// B6. Certificados TLS (antes "Lts")
Table CertificadosTls {
  id_certificado          int               [pk, increment]
  nombre_certificado      varchar(24)       [not null]
  tipo                    TipoCertificado   [not null, default: 'CERT_SERVIDOR']
  certificado_pem         text              [not null]
  clave_privada_cifrado   text              [note: 'Solo para CERT_SERVIDOR. Cifrada con CLAVE_CIFRADO_COLUMNAS']
  fingerprint_sha256      varchar(64)       [unique, not null, note: 'Es lo que la app Electron fija (pinning)']
  cadena_certificados     varchar(64)       [default: 'CA-UNTDF-ROOT']
  valido_desde            bigint            [not null]
  valido_hasta            bigint            [not null]
  estado                  EstadoCertificado [not null, default: 'CERT_ACTIVO', note: 'CERT_SIGUIENTE permite rotar con solape']
  fecha_creacion          bigint
  fecha_modificacion      bigint
}

// B7. Claves internas del sistema (con versiones para rotar)
Table ClaveSistema {
  id_clave_sistema  int                 [pk, increment]
  proposito         ClaveProposito      [not null]
  version           int                 [not null, default: 1]
  material          varchar(64)         [not null, note: '32 bytes aleatorios en hex (RNG de hardware)']
  estado            EstadoClaveSistema  [not null, default: 'CLAVESIS_ACTIVA']
  fecha_creacion    bigint
  fecha_retiro      bigint              [default: 0]

  Indexes {
    (proposito, version) [unique, name: 'uq_clave_version']
  }
  Note: 'Una sola ACTIVA por propósito. Las RETIRADAS se conservan para descifrar o verificar datos viejos.'
}

// B8. Bloqueo por origen (fuerza bruta y abuso)
Table BloqueoOrigen {
  id_bloqueo        int          [pk, increment]
  origen_remoto     varchar(46)  [unique, not null]
  intentos          int          [not null, default: 0]
  ventana_inicio    bigint
  bloqueado_hasta   bigint       [default: 0]
  fecha_modificacion bigint
}

// B9. Aprovisionamiento del primer arranque (singleton)
Table Aprovisionamiento {
  id_aprovisionamiento   int                      [pk, default: 1, note: 'Singleton: CHECK (id = 1)']
  estado                 EstadoAprovisionamiento  [not null, default: 'APROV_VIRGEN']
  codigo_setup_hash      varchar(64)              [default: '', note: 'Hash del código de un solo uso para crear el primer admin']
  codigo_setup_salt      varchar(32)              [default: '']
  intentos_restantes     int                      [default: 5]
  fecha_listo            bigint                   [default: 0]

  Note: 'Al pasar a APROV_LISTO se vacían codigo_setup_hash y codigo_setup_salt. Sin contraseñas por defecto.'
}

// B10. Confianza en el reloj (singleton)
Table EstadoReloj {
  id_estado_reloj  int           [pk, default: 1, note: 'Singleton: CHECK (id = 1)']
  piso_ts          bigint        [not null, default: 0, note: 'Última hora válida conocida. La hora nunca puede ser menor']
  fuente           FuenteTiempo  [not null, default: 'TIEMPO_SIN_SINCRONIZAR']
  ultimo_ntp_ts    bigint        [default: 0]
  boot_count       int           [not null, default: 0, note: 'Se incrementa en cada arranque. Es el boot_id que se copia a los registros']

  Note: '''
  Reglas para aceptar la hora de un cliente:
  1) Solo si NTP no respondió y PoliticaSeguridad.hora_cliente_permitida = 1.
  2) Solo desde una sesión con rol OPERADOR o ADMIN.
  3) Debe ser mayor que piso_ts y que la fecha de compilación del firmware.
  4) Se marca TIEMPO_CLIENTE y se audita.
  5) Cuando NTP responde, lo reemplaza (EventoSistema TIEMPO_SINCRONIZADO).
  6) Con TIEMPO_CLIENTE no se valida el vencimiento de certificados.
  '''
}

// =========================================================
// GRUPO C: INFRAESTRUCTURA
// =========================================================
Table SchemaMeta {
  id_meta          int          [pk, default: 1, note: 'Singleton: CHECK (id_meta = 1)']
  schema_version   int          [not null, note: 'Para migraciones. Espejo de PRAGMA user_version']
  firmware_creador varchar(16)
  fecha_creacion   bigint       [not null]
}

// =========================================================
// GRUPOS VISUALES (dbdiagram.io)
// =========================================================
TableGroup A_SISTEMA {
  Sensor
  Senso
  EventoSensor
  EventoSistema
  Correos
  CorreoEnvio
  ConfiguracionSmtp
  ConfiguracionConectividad
  Calibracion
  ServidoresNtp
  ConfiguracionSistema
  Auditoria
}

TableGroup B_SEGURIDAD {
  Usuarios
  ClavesPublicas
  Sesiones
  PermisosRol
  PoliticaSeguridad
  CertificadosTls
  ClaveSistema
  BloqueoOrigen
  Aprovisionamiento
  EstadoReloj
}

TableGroup C_INFRA {
  SchemaMeta
}

// ----------------- RELACIONES -----------------
Ref: Auditoria.id_usuario           > Usuarios.id_usuario        [delete: restrict]
Ref: ClavesPublicas.id_usuario      > Usuarios.id_usuario        [delete: restrict]
Ref: ClavesPublicas.id_aprobada_por > Usuarios.id_usuario        [delete: restrict]
Ref: Sesiones.id_usuario            > Usuarios.id_usuario        [delete: cascade]
Ref: Sesiones.id_clave              > ClavesPublicas.id_clave    [delete: set null]
Ref: CorreoEnvio.id_correo          > Correos.id_correo          [delete: cascade]
Ref: CorreoEnvio.id_evento_sensor   > EventoSensor.id_evento_sensor     [delete: cascade]
Ref: CorreoEnvio.id_evento_sistema  > EventoSistema.id_evento_sistema   [delete: cascade]
Ref: Senso.id_sensor                > Sensor.id_sensor           [delete: restrict]
Ref: EventoSensor.id_sensor         > Sensor.id_sensor           [delete: restrict]
Ref: EventoSensor.id_senso          > Senso.id_senso             [delete: cascade]

// =========================================================
// DATOS INICIALES (sembrar al crear la base, no son tablas)
// =========================================================
// Usuarios:     id 0 "anonimo" ROL_ANONIMO, activa = 1, sin login posible
// Singletons:   una fila con id = 1 en cada tabla singleton
// ClaveSistema: una clave ACTIVA por cada ClaveProposito (RNG de hardware)
// Aprovisionamiento: estado APROV_VIRGEN
//
// PermisosRol sugerido (deny por defecto; solo se listan los permitidos):
//   ROL_ANONIMO : ninguno (solo el endpoint de login)
//   ROL_LECTOR  : VER sobre SENSORES, SENSOS, EVENTOS, CALIBRACION
//   ROL_OPERADOR: lo de LECTOR + MODIFICAR SENSORES (umbrales, nombre),
//                 VER/CREAR/MODIFICAR CORREOS, VER AUDITORIA
//   ROL_ADMIN   : todas las acciones sobre todos los recursos
